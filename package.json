{
  "name": "openworld-city",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:stress": "playwright test tests/e2e/streaming.spec.ts",
    "test:soak": "node scripts/streaming-soak.mjs",
    "test:startup": "node scripts/measure-startup.mjs",
    "assets:verify": "python3 scripts/assets.py"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.19.3",
    "three": "^0.183.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^22",
    "@types/three": "^0.183.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.0",
    "vitest": "^4.0.0"
  }
}
